---
import { formatDate } from "../utils";

interface Props {
  post: any;
}

const { post } = Astro.props;

const getImageUrl = (image: any) => {
  if (!image?.asset?._ref) return null;
  const ref = image.asset._ref;
  const [_type, hash, dimensions, format] = ref.split('-');
  return `https://cdn.sanity.io/images/${import.meta.env.PUBLIC_SANITY_STUDIO_PROJECT_ID}/${import.meta.env.PUBLIC_SANITY_STUDIO_DATASET}/${hash}-${dimensions}.${format}`;
};

const imgUrl = getImageUrl(post.metadata?.image);
---

<a href={`/blog/${post.slug}`} class="block group border rounded-lg overflow-hidden hover:shadow-lg transition bg-white">
  {imgUrl ? (
    <img src={imgUrl} alt={post.title || ""} class="w-full h-56 object-cover" />
  ) : (
    <div class="w-full h-56 bg-gray-200" />
  )}
  <div class="p-6">
    <h2 class="text-2xl font-bold group-hover:text-blue-600 transition">{post.title}</h2>
    <p class="text-sm text-gray-500 mt-2">
      {formatDate(post.publishDate || post._createdAt)}
    </p>
    {post.metadata?.description && (
      <p class="mt-3 text-gray-700 line-clamp-3">{post.metadata.description}</p>
    )}
  </div>
</a>
