---
import Layout from "../layouts/Layout.astro";
import { PortableText } from "astro-portabletext";
import { sanityClient } from "sanity:client";

// Build ke waqt Sanity se saare pages uthata hai
export async function getStaticPaths() {
  const pages = await sanityClient.fetch(`*[_type == "page" && defined(slug.current)]{ "slug": slug.current }`);
  return pages.map((page: { slug: string }) => ({
    params: { slug: page.slug },
  }));
}

const { slug } = Astro.params;

// Us specific page ka data fetch karta hai
const page = await sanityClient.fetch(`*[_type == "page" && slug.current == $slug][0]`);

if (!page) {
  return Astro.rewrite('/404');
}
---

<Layout title={page.title || "Page"} description={page.seo?.metaDescription || ""}>
  <div class="max-w-3xl mx-auto px-4 py-12 pt-24">
    <h1 class="text-4xl font-extrabold mb-8 text-[#111]">{page.title}</h1>
    
    {page.content ? (
      <div class="prose prose-lg prose-serif max-w-none text-[#333]">
        <PortableText value={page.content} />
      </div>
    ) : (
      <p class="text-gray-500">Is page mein abhi koi content nahi hai. Sanity mein jakar content likhein.</p>
    )}
  </div>
</Layout>
