{posts.map((post) => {
  if (!post.slug) return null;
  return (
    <a href={`/post/${post.slug}`} class="block group border rounded-lg overflow-hidden hover:shadow-lg transition bg-white">
      <div class="p-6">
        <h2 class="text-2xl font-bold group-hover:text-blue-600 transition">{post.title}</h2>
        <p class="text-sm text-gray-500 mt-2">
          {formatDate(post.publishDate || post._createdAt)}
        </p>
        {post.metadata?.description && (
          <p class="mt-3 text-gray-700 line-clamp-3">{post.metadata.description}</p>
        )}
      </div>
    </a>
  );
})}
