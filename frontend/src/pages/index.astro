---
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../utils/sanity";

const posts = await getPosts();

// Nest jaisa short date: "Sep 16, 2026"
// Shared formatDate utils nahi chhedha, taki dusre pages na toot jayein
const formatShortDate = (value: string) =>
  new Date(value).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });

const getImageUrl = (post: any) => {
  let imageRef = post.metadata?.image?.asset?._ref;
  
  if (!imageRef && post.content) {
    const imageBlock = post.content.find((block: any) => block._type === 'image');
    imageRef = imageBlock?.asset?._ref;
  }

  if (!imageRef) return null;
  
  const [_type, hash, dimensions, format] = imageRef.split('-');
  return `https://cdn.sanity.io/images/${import.meta.env.PUBLIC_SANITY_STUDIO_PROJECT_ID}/${import.meta.env.PUBLIC_SANITY_STUDIO_DATASET}/${hash}-${dimensions}.${format}`;
};
---

<Layout title="Home">
  <!-- Mobile par px-2 (Nest jaisa inset), desktop par px-6 -->
  <div class="w-full max-w-3xl mx-auto px-2 md:px-6 pt-24 pb-16">
    
    <div class="flex flex-col gap-14">
      {posts.map((post) => {
        const imgUrl = getImageUrl(post);
        const categoryName = post.categories && post.categories.length > 0 ? post.categories[0] : "Post";
        const dateText = formatShortDate(post.publishDate || post._createdAt);
        
        return (
          <a href={`/post/${post.slug}`} class="block group">
            
            {imgUrl ? (
              <!-- Desktop par hover, mobile par tap (group-active) par zoom -->
              <div class="w-full aspect-[3/2] md:aspect-[1.8/1] rounded-2xl overflow-hidden mb-5 bg-gray-100">
                <img 
                  src={imgUrl} 
                  alt={post.title} 
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 group-active:scale-105" 
                />
              </div>
            ) : (
              <div class="w-full aspect-[3/2] md:aspect-[1.8/1] bg-gray-100 rounded-2xl mb-5 flex items-center justify-center text-gray-400 font-medium">
                No Image
              </div>
            )}

            <div class="flex items-center gap-2.5 text-[15px] font-medium mb-2">
              <span class="text-[#0e7490]">{categoryName}</span>
              <span class="text-gray-400">·</span>
              <span class="text-[#5f6368] font-normal">
                {dateText}
              </span>
            </div>
            
            <!-- Desktop par hover, mobile par tap (group-active) par underline -->
            <h2 class="text-[22px] md:text-4xl font-semibold mb-3 text-[#1a1a1a] leading-tight tracking-tight group-hover:underline group-active:underline underline-offset-4 decoration-2">
              {post.title}
            </h2>
            
            {post.metadata?.description && (
              <p class="text-[17px] text-[#5f6368] leading-[1.6] line-clamp-2">
                {post.metadata.description}
              </p>
            )}
          </a>
        );
      })}
    </div>

  </div>
</Layout>
